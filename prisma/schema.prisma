generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Template {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String
  createdById    String

  name          String
  description   String @default("")
  metadata      Json   @default("{}") @db.JsonB
  fields        Json   @default("[]") @db.JsonB
  draftRevision Int    @default(1)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  versions TemplateVersion[]

  @@unique([id, organizationId])
  @@index([organizationId, updatedAt])
  @@map("templates")
}

model TemplateVersion {
  id             String @id @default(uuid()) @db.Uuid
  templateId     String @db.Uuid
  organizationId String

  version             Int
  sourceDraftRevision Int

  name        String
  description String @default("")
  metadata    Json   @db.JsonB
  fields      Json   @db.JsonB

  publishedById String
  publishedAt   DateTime     @default(now()) @db.Timestamptz(3)
  submissions   Submission[]

  template Template @relation(fields: [templateId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([templateId, version])
  @@unique([templateId, sourceDraftRevision])
  @@unique([id, organizationId])
  @@index([organizationId, publishedAt])
  @@map("template_versions")
}

enum SiteStatus {
  ACTIVE
  INACTIVE
}

model Warehouse {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String
  createdById    String?

  name       String
  city       String
  address    String?    @default("")
  supervisor String     @default("Unassigned")
  status     SiteStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, updatedAt])
  @@map("warehouses")
}

enum SubmissionReviewDecision {
  APPROVED
  REJECTED
}

model Submission {
  id                String @id @default(uuid()) @db.Uuid
  organizationId    String
  taskId            String
  templateVersionId String @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  templateVersion TemplateVersion @relation(fields: [templateVersionId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)

  attempts SubmissionAttempt[]

  @@unique([id, organizationId])
  @@unique([organizationId, taskId])
  @@index([organizationId, createdAt])
  @@map("submissions")
}

model SubmissionAttempt {
  id              String @id @default(uuid()) @db.Uuid
  organizationId  String
  submissionId    String @db.Uuid
  attemptNumber   Int
  clientAttemptId String
  submittedById   String

  answers     Json     @db.JsonB
  submittedAt DateTime @default(now()) @db.Timestamptz(3)

  submission Submission @relation(fields: [submissionId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)

  review SubmissionReview?

  @@unique([id, organizationId])
  @@unique([submissionId, attemptNumber])
  @@unique([organizationId, clientAttemptId])
  @@index([organizationId, submittedAt])
  @@map("submission_attempts")
}

model SubmissionReview {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String
  attemptId      String @db.Uuid
  reviewedById   String

  decision   SubmissionReviewDecision
  note       String                   @default("")
  reviewedAt DateTime                 @default(now()) @db.Timestamptz(3)

  attempt SubmissionAttempt @relation(fields: [attemptId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([attemptId, organizationId])
  @@index([organizationId, reviewedAt])
  @@map("submission_reviews")
}
